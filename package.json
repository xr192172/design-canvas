{
  "name": "design-canvas",
  "version": "0.1.3",
  "description": "人机共享的可视化协议层。LLM 输出结构化 DSL JSON → 协作前端渲染成可交互图 → 人看图改 JSON → LLM 读 JSON 迭代。本仓库是数据/协议层，可视化由独立前端承载，内置精简渲染器仅作预览兜底。作为 MCP 服务对外开放。",
  "license": "MIT",
  "type": "module",
  "bin": {
    "design-canvas": "dist/src/server.js"
  },
  "scripts": {
    "build": "node scripts/gen_anim_core_bundle.mjs && tsc",
    "start": "node dist/src/server.js",
    "serve": "node dist/src/tools/serve.js",
    "daemon": "node dist/src/daemon/daemon.js",
    "instrument": "node dist/src/camera/instrument_cli.js",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --doctor",
    "rebuild": "node scripts/rebuild_feature.mjs",
    "dogfood": "node dist/src/tools/dogfood_stats.js",
    "brickify": "node dist/src/tools/brickify_cli.js",
    "signal-review": "node dist/src/tools/signal_review_cli.js",
    "split-stage": "node dist/src/tools/split_stage_cli.js",
    "deprecate-offline": "node dist/src/tools/deprecate_offline_cli.js",
    "capability": "node dist/src/tools/capability_cli.js",
    "diagnose": "node dist/src/tools/diagnose_cli.js",
    "diagnose-loop": "node dist/src/tools/diagnose_loop_cli.js",
    "upgrade-scan": "node dist/src/tools/upgrade_cli.js",
    "impact": "node dist/src/tools/impact_cli.js",
    "upgrade-rewrite": "node dist/src/tools/upgrade_rewrite_cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "hub": "node scripts/hub.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.2",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
