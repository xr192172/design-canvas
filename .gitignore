# Dependencies
node_modules/

# Build output
dist/
build/

# 渲染产物（HTML 文件，含嵌套目录）
output/

# 布局腐坏备份 / 诊断脚本等临时产物
.backup/

# 一次性临时脚本
scripts/*.tmp.mjs

# 运行时持久化的 DSL（用户实际使用时生成；examples/ 目录的示例需要提交）
.design-canvas/
# MCP server 运行时 DSL（项目根，随使用场景变化，不入库）
design-canvas.json

# 测试覆盖率
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 环境变量
.env
.env.local

# 临时文件
*.tmp
*.bak

# 参考库（借鉴用，不属于本项目代码）
vendor/

# codegraph 根目录残留（重复拷贝，已移至 vendor/codegraph；剩余 .git/pack 被 IDE 占用，释放后可删）
codegraph/

