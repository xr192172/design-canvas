{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design-canvas.dev/schema/design_dsl.schema.json",
  "title": "design-canvas DSL",
  "description": "双层 DSL：几何层（位置/样式）+ 语义层（文件/API/依赖）",
  "type": "object",
  "required": ["id", "type", "feature", "geometry"],
  "properties": {
    "id": {
      "type": "string",
      "description": "图纸唯一 ID（URL 安全）",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "type": {
      "type": "string",
      "const": "feature_diagram"
    },
    "feature": {
      "type": "string",
      "description": "feature 名，用于 get_dsl / list_features",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "version": {
      "type": "string",
      "description": "DSL 版本（语义化版本号）"
    },
    "title": {
      "type": "string",
      "description": "人类可读标题"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_progress", "done"]
    },
    "geometry": {
      "$ref": "#/definitions/Geometry"
    },
    "semantic": {
      "$ref": "#/definitions/Semantic"
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/definitions/Annotation" }
    },
    "theme": {
      "type": "string",
      "enum": ["dynamic", "blue", "sakura", "forest", "ocean", "star"],
      "description": "主题 ID"
    },
    "animations_v2": {
      "$ref": "#/definitions/AnimationSystem"
    },
    "simulation": {
      "$ref": "#/definitions/Simulation"
    },
    "reasoning": {
      "$ref": "#/definitions/ReasoningSystem"
    },
    "canvas_notes": {
      "type": "array",
      "description": "批注层数据（阶段 C）：手绘批注覆盖层持久化（高亮/箭头/便签/文本），独立于语义模型，仅供前端画布渲染与协作",
      "items": { "$ref": "#/definitions/CanvasNote" }
    }
  },
  "definitions": {
    "Geometry": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["grid", "vertical_flow", "horizontal_flow", "free"],
          "description": "自动排版策略，free=完全用 x/y"
        },
        "width": { "type": "number", "description": "画布宽度（px）" },
        "height": { "type": "number", "description": "画布高度（px）" },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "description": "grid 布局列数"
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/definitions/Edge" }
        }
      }
    },
    "Node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "description": "节点 ID，语义层 file.id 通过它锚定"
        },
        "label": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "layer": {
          "type": "string",
          "enum": ["main", "error", "detail"],
          "description": "职责分层：main=主干（默认显示）；error/detail=深层（默认折叠，角标展开）。缺省 main"
        },
        "host": {
          "type": "string",
          "description": "深层节点的宿主主干节点 ID（角标挂载点）；缺省时仅跟随全局层开关"
        },
        "shapes": {
          "type": "object",
          "description": "数据形状卡（D1）：进/出该节点的数据形状（AnimationValueSchema，人话渲染，纯展示）",
          "properties": {
            "in": { "type": "object", "description": "进料口数据形状（JSON Schema 格式）" },
            "out": { "type": "object", "description": "出料口数据形状（JSON Schema 格式）" }
          },
          "additionalProperties": false
        },
        "style": {
          "type": "object",
          "properties": {
            "bg": { "type": "string", "description": "背景色" },
            "color": { "type": "string", "description": "前景色" },
            "border": { "type": "string" },
            "borderRadius": { "type": "number" }
          },
          "additionalProperties": true
        }
      }
    },
    "Edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string", "description": "源节点 ID" },
        "to": { "type": "string", "description": "目标节点 ID" },
        "label": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["main", "error", "detail"],
          "description": "职责分层：缺省时自动推导——任一端点为深层节点则跟随较深层"
        },
        "style": {
          "type": "object",
          "properties": {
            "stroke": { "type": "string" },
            "strokeWidth": { "type": "number" }
          },
          "additionalProperties": true
        }
      }
    },
    "Semantic": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/File" }
        },
        "multi_file_invariants": {
          "type": "array",
          "items": { "type": "string" },
          "description": "不变式规则，design_check 会验证"
        },
        "expected_global_behavior": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "File": {
      "type": "object",
      "required": ["id", "path", "responsibility"],
      "properties": {
        "id": {
          "type": "string",
          "description": "与 geometry.nodes.id 对应"
        },
        "path": { "type": "string" },
        "responsibility": { "type": "string" },
        "expected_apis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signature"],
            "properties": {
              "signature": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "expected_deps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_behavior": { "type": "string" },
        "layer": { "type": "string", "description": "架构层 id（序号5：architecture-analyzer 推断，如 api/service/data/ui）" },
        "contract": { "$ref": "#/definitions/BrickContract" }
      }
    },
    "BrickContract": {
      "type": "object",
      "required": ["schema_version", "role", "shapes", "effects"],
      "properties": {
        "schema_version": { "type": "number", "enum": [1] },
        "role": {
          "type": "object",
          "required": ["class", "basis", "confidence"],
          "properties": {
            "class": { "type": "string", "enum": ["business", "functional", "hybrid"] },
            "basis": { "type": "string", "enum": ["graph", "runtime", "llm", "mixed"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "shapes": {
          "type": "object",
          "required": ["exposes", "consumes"],
          "properties": {
            "exposes": { "type": "array", "items": { "$ref": "#/definitions/ShapeSchema" } },
            "consumes": { "type": "array", "items": { "$ref": "#/definitions/ShapeSchema" } }
          }
        },
        "effects": {
          "type": "object",
          "required": ["writes", "holds", "emits", "reads_config"],
          "properties": {
            "writes": { "type": "array", "items": { "$ref": "#/definitions/EffectTarget" } },
            "holds": { "type": "array", "items": { "$ref": "#/definitions/EffectTarget" } },
            "emits": { "type": "array", "items": { "type": "string" } },
            "reads_config": { "type": "array", "items": { "type": "string" } }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["call_count", "top_callers", "observed_targets"],
          "properties": {
            "call_count": { "type": "number" },
            "top_callers": { "type": "array", "items": { "type": "string" } },
            "observed_targets": { "type": "array", "items": { "type": "string" } },
            "last_seen": { "type": "string" }
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source_project": { "type": "string" },
            "commit": { "type": "string" },
            "harvested_at": { "type": "string" },
            "last_reconciled": { "type": "string", "description": "最近一次 camera 动静对账时间" }
          }
        }
      }
    },
    "ShapeSchema": {
      "type": "object",
      "required": ["name", "kind", "fields", "origin"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["struct", "interface", "type", "class"] },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "origin": { "type": "string", "enum": ["ast", "runtime", "llm"] },
        "notes": { "type": "string" }
      }
    },
    "EffectTarget": {
      "type": "object",
      "required": ["target", "op"],
      "properties": {
        "target": { "type": "string" },
        "op": { "type": "string", "enum": ["write", "append", "delete", "acquire", "release"] },
        "reversible": { "type": "string" },
        "origin": { "type": "string", "enum": ["ast", "runtime"], "description": "ast=静态扫描候选；runtime=camera 实测确认" }
      }
    },
    "Annotation": {
      "type": "object",
      "required": ["id", "text"],
      "anyOf": [
        { "required": ["target_id"] },
        { "required": ["node_id"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "target_id": { "type": "string", "description": "指向 node.id 或 edge.id" },
        "node_id": { "type": "string", "description": "直接指明所属节点 ID（兼容字段）" },
        "text": { "type": "string" },
        "author": { "type": "string", "enum": ["human", "llm"] },
        "created": { "type": "string", "format": "date-time" }
      }
    },
    "CanvasNote": {
      "type": "object",
      "required": ["id", "type"],
      "description": "批注层图元：手绘自由笔迹 / 箭头 / 圈注椭圆 / 便签 / 文本。坐标均为画布世界坐标（world px）",
      "properties": {
        "id": { "type": "string", "description": "图元唯一 ID" },
        "groupId": { "type": "string", "description": "批注套 ID：同一次批注层会话（开启→关闭）内创建的图元共享同一套，一套=一个批注；历史数据缺省时按单元素处理" },
        "type": {
          "type": "string",
          "enum": ["highlight", "arrow", "oval", "sticky", "text"],
          "description": "highlight=高亮笔自由笔迹；arrow=箭头；oval=圈注红色虚线椭圆（points=[中心,边缘]）；sticky=便签；text=文本"
        },
        "points": {
          "type": "array",
          "description": "笔迹/箭头关键点序列 [[x,y],...]（世界坐标）；oval 时 [中心点, 边缘点]",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "x": { "type": "number", "description": "便签/文本锚点 x（世界坐标）" },
        "y": { "type": "number", "description": "便签/文本锚点 y（世界坐标）" },
        "w": { "type": "number", "description": "便签/文本宽度（世界 px）" },
        "h": { "type": "number", "description": "便签/文本高度（世界 px）" },
        "text": { "type": "string", "description": "便签/文本内容" },
        "color": { "type": "string", "description": "颜色（CSS 色值）" },
        "strokeWidth": { "type": "number", "description": "笔迹/箭头线宽（世界 px）" },
        "created": { "type": "string", "format": "date-time", "description": "创建时间" }
      },
      "additionalProperties": true
    },
    "Simulation": {
      "type": "object",
      "required": ["id", "initial_state", "rules"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "initial_state": {
          "type": "array",
          "items": { "$ref": "#/definitions/SimulationStateDef" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/definitions/SimulationRule" }
        },
        "mappings": {
          "type": "array",
          "items": { "$ref": "#/definitions/SimulationNodeMapping" }
        }
      }
    },
    "SimulationStateDef": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": {},
        "type": { "type": "string", "enum": ["number", "string", "boolean", "array", "object"] },
        "description": { "type": "string" }
      }
    },
    "SimulationRule": {
      "type": "object",
      "required": ["id", "event", "actions"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "event": { "type": "string" },
        "condition": { "type": "string" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/SimulationAction" }
        },
        "emits": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SimulationAction": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["set_state", "increment", "decrement", "push", "pop", "move", "highlight", "log", "call"] },
        "target": { "type": "string" },
        "value": {},
        "amount": { "type": "number" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "SimulationNodeMapping": {
      "type": "object",
      "required": ["stateKey", "nodeId"],
      "properties": {
        "stateKey": { "type": "string" },
        "nodeId": { "type": "string" },
        "labelTemplate": { "type": "string" },
        "styleMap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "style"],
            "properties": {
              "when": { "type": "string" },
              "style": { "type": "object" }
            }
          }
        }
      }
    },
    "AnimationSystem": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "number" },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/AnimationFlow" }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["mock", "live"] },
            "code_dir": { "type": "string" },
            "entry": { "type": "string" },
            "timeout": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "AnimationFlow": {
      "type": "object",
      "required": ["id", "trigger", "from"],
      "properties": {
        "id": { "type": "string" },
        "trigger": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["periodic", "event", "state_change", "manual"] },
            "interval": { "type": "number" },
            "event": { "type": "string" },
            "watch": { "type": "string" }
          },
          "additionalProperties": true
        },
        "from": { "type": "string", "description": "源节点 ID" },
        "to": { "type": "string", "description": "目标节点 ID（L2 直连；L3 用 branches 替代）" },
        "value": { "$ref": "#/definitions/AnimationValue" },
        "branches": {
          "type": "array",
          "description": "L3 条件分支，与 to 互斥；按声明顺序求值，第一个命中者生效",
          "items": {
            "type": "object",
            "required": ["to"],
            "properties": {
              "condition": { "type": "string", "description": "JS 表达式（访问 value）；else/true/default/空 为兜底" },
              "to": { "type": "string" },
              "value": { "$ref": "#/definitions/AnimationValue" },
              "effect": { "type": "string", "description": "particle_red / particle_green 等颜色提示" }
            },
            "additionalProperties": true
          }
        },
        "mock_values": {
          "type": "array",
          "description": "L3 mock 数据源：periodic 触发时轮流播放的求值上下文 value",
          "items": { "type": "object" }
        },
        "handler": {
          "type": "object",
          "description": "L4 函数绑定",
          "required": ["file_id", "api"],
          "properties": {
            "file_id": { "type": "string" },
            "api": { "type": "string" },
            "input_mapping": { "type": "object", "additionalProperties": { "type": "string" } },
            "output_mapping": { "type": "object", "additionalProperties": { "type": "string" } },
            "errors": {
              "type": "array",
              "description": "L4.5 异常声明",
              "items": {
                "type": "object",
                "required": ["type", "condition", "severity", "to"],
                "properties": {
                  "type": { "type": "string" },
                  "condition": { "type": "string" },
                  "severity": { "type": "string", "enum": ["expected", "unexpected"] },
                  "to": { "type": "string" },
                  "value": { "$ref": "#/definitions/AnimationValue" },
                  "effect": { "type": "string" },
                  "log": { "type": "string" }
                },
                "additionalProperties": true
              }
            },
            "live": { "type": "boolean" },
            "mock_result": { "description": "mock 模式固定返回值（mock_results 为空时生效）" },
            "mock_results": {
              "type": "array",
              "description": "mock 模式轮换返回值（优先于 mock_result；可混入 { error } / { panic: true } 演示 L4.5 异常路径）",
              "items": { "type": "object" }
            }
          },
          "additionalProperties": true
        },
        "effect": { "type": "string" },
        "on_arrive": { "type": "string" },
        "source_key": { "type": "string" },
        "layout": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "AnimationValue": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "label": { "type": "string" },
        "fields": { "type": "object", "description": "JSON Schema 格式的字段结构" }
      },
      "additionalProperties": true
    },
    "ReasoningStep": {
      "type": "object",
      "required": ["id", "node", "kind", "tokens", "reasoning"],
      "properties": {
        "id": { "type": "string", "description": "步骤 ID（唯一，供 folds.folded 引用）" },
        "node": { "type": "string", "description": "步骤所在节点 id（引用 geometry.nodes[].id）" },
        "kind": { "type": "string", "enum": ["think", "tool", "respond", "fold"], "description": "步骤类型" },
        "tokens": { "type": "number", "minimum": 0, "description": "该步占用/消耗 token 数" },
        "input": { "type": "string", "description": "该步输入上下文描述" },
        "reasoning": { "type": "string", "description": "LLM 推理内容（回放时浮层显示）" },
        "output": { "type": "string", "description": "该步输出" },
        "api": { "type": "string", "description": "该步绑定的函数名（L4 浮层 ƒ api）" }
      },
      "additionalProperties": true
    },
    "ReasoningFold": {
      "type": "object",
      "required": ["at_step", "node", "kind", "summary", "folded"],
      "properties": {
        "at_step": { "type": "integer", "minimum": 1, "description": "在哪一步之后触发（steps 索引，从 1 起）" },
        "node": { "type": "string", "description": "折叠目标节点 id" },
        "kind": { "type": "string", "enum": ["summarize", "evict"], "description": "折叠方式" },
        "summary": { "type": "string", "description": "折叠后生成的摘要文本" },
        "folded": { "type": "array", "items": { "type": "string" }, "description": "被折叠的步骤 id 列表" }
      },
      "additionalProperties": true
    },
    "ReasoningBudget": {
      "type": "object",
      "required": ["max_tokens"],
      "properties": {
        "max_tokens": { "type": "number", "minimum": 1, "description": "上下文窗口 token 上限" },
        "fold_at": { "type": "number", "minimum": 0, "maximum": 1, "description": "触发折叠的阈值比例（默认 0.8）" }
      },
      "additionalProperties": true
    },
    "ReasoningEntry": {
      "type": "object",
      "required": ["label", "node"],
      "properties": {
        "label": { "type": "string", "description": "入口标签" },
        "node": { "type": "string", "description": "入口节点 id" }
      },
      "additionalProperties": true
    },
    "ReasoningSystem": {
      "type": "object",
      "required": ["version", "entry", "steps"],
      "properties": {
        "version": { "type": "integer" },
        "entry": { "$ref": "#/definitions/ReasoningEntry" },
        "budget": { "$ref": "#/definitions/ReasoningBudget" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/ReasoningStep" }
        },
        "folds": {
          "type": "array",
          "items": { "$ref": "#/definitions/ReasoningFold" }
        }
      },
      "additionalProperties": true
    }
  }
}

